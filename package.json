{
  "name": "civicconnect-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CivicConnect AI — Smart-City Grievance Management Platform",
  "scripts": {
    "start": "bash ./start.sh",
    "dev": "bash ./start.sh",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test",
    "backend:dev": "cd backend && venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "backend:test": "cd backend && venv/bin/pytest -v",
    "test": "npm run backend:test && npm run frontend:test",
    "build": "npm run frontend:build"
  }
}
